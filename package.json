{
    "name":  "sira-mathematics-assessment",
    "version":  "1.0.0",
    "private":  true,
    "type":  "module",
    "description":  "SIRA 60-minute mathematics placement readiness diagnostic",
    "engines":  {
                    "node":  "22.x"
                },
    "scripts":  {
                    "test":  "node scripts/build.mjs && node --test tests/*.test.js",
